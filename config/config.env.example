# NiriShift user config (copied to ~/.config/niri-shift/config.env)
# Values are mirrored into ~/.config/environment.d/gamescope-session-plus.conf by niri-shift-settings.

# Primary display for gamescope-session (connector name from `niri msg outputs`)
OUTPUT_CONNECTOR=DP-1

# Comma-separated refresh rates; highest used with --nested-refresh patch
CUSTOM_REFRESH_RATES=60,120,144

# Optional: disable these outputs before SDDM flip (comma-separated)
OUTPUT_CONNECTOR_TO_DISABLE=
